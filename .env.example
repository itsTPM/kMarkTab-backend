# Unsplash access key (production keys have 1000 requests per hour)
UNSPLASH_ACCESS_KEY=
# The curated collection served by GET /v1/curated
CURATED_COLLECTION_ID=
PORT=3000
# Where the curated collection is kept between restarts
DATA_DIR=./data
# Minutes between curated collection syncs
CURATED_SYNC_MINUTES=360
# Set to 1 behind a reverse proxy, so the client IP is taken from X-Forwarded-For
TRUST_PROXY=0
# The domain Caddy serves the API on, for docker compose (its DNS must point to the server)
DOMAIN=
